{
  "name": "task-scheduler",
  "version": "1.0.0",
  "description": "Task scheduler with cron and drizzle",
  "keywords": [
    "task-scheduler",
    "cron",
    "drizzle",
    "libsql",
    "node",
    "typescript",
    "pnpm"
  ],
  "author": {
    "name": "Fernando Uribe",
    "email": "fjuribe.14@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fjuribe14/task-scheduler.git"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#/*.js": "./dist/*.js"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "mssql:env": "set NODE_OPTIONS=--tls-cipher-list=DEFAULT@SECLEVEL=0",
    "dev": "tsx watch src/index.ts",
    "dev:mssql": "pnpm mssql:env && pnpm dev",
    "build": "pnpm run format && pnpm run lint && tsc",
    "start": "pnpm mssql:env && node dist/index.js",
    "format": "biome check --write .",
    "lint": "biome check . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "pm2:start": "pm2 start dist/index.js --name task-scheduler",
    "pm2:start:mssql": "pm2 start dist/index.js --name task-scheduler --node-args=\"--tls-cipher-list=DEFAULT@SECLEVEL=0 --tls-min-v1.0\"",
    "pm2:dev": "pm2 start dist/index.js --name task-scheduler --watch",
    "pm2:dev:mssql": "pm2 start dist/index.js --name task-scheduler --node-args=\"--tls-cipher-list=DEFAULT@SECLEVEL=0 --tls-min-v1.0\" --watch",
    "pm2:stop": "pm2 stop task-scheduler",
    "pm2:restart": "pm2 restart task-scheduler",
    "pm2:delete": "pm2 delete task-scheduler",
    "pm2:list": "pm2 list",
    "pm2:logs": "pm2 logs task-scheduler",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@sentry/node": "^10.55.0",
    "cron": "^4.4.0",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.22",
    "mssql": "^12.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "1.0.0-beta.22",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
