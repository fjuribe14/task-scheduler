# For use MSSQL need add this env-variable tp run with TLS 1.0  
# Windows set NODE_OPTIONS=--tls-cipher-list=DEFAULT@SECLEVEL=0
# Mac/Linux $env:NODE_OPTIONS="--tls-cipher-list=DEFAULT@SECLEVEL=0"
# Go to README.md
NODE_OPTIONS="--tls-cipher-list=DEFAULT@SECLEVEL=0"

LOG_LEVEL="INFO"

# DATABASE 
DATABASE_PROVIDER="mssql"
DATABASE_URL=""
DATABASE_HOST=""
DATABASE_NAME=""
DATABASE_USER=""
DATABASE_PASSWORD=""

# Dolar API
# More info https://dolarapi.com/docs/venezuela/
DOLAR_API_URL="https://ve.dolarapi.com/v1"

# Cotiza Ve
# More info https://cotizave.com/
COTIZAVE_API_URL="https://api.cotizave.com/v1/fx"
COTIZAVE_API_KEY=""

# Cron Generator
# More info https://crontab.cronhub.io/
COTIZAVE_BCV_CRON="0 1,6 * * *"
COTIZAVE_PAR_CRON="0 1,6 * * *"
COTIZAVE_P2P_CRON="0 1,6 * * *"